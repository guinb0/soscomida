# Copie para infra/docker/.env.prod no servidor (fora do git) e preencha.
# Variáveis do compose (interpoladas) e da API/worker (env_file).

# --- compose ---
REGISTRY=ghcr.io/SEU_USUARIO
TAG=
DOMAIN=
ACME_EMAIL=
POSTGRES_PASSWORD=
# 36+ bytes aleatórios; compartilhado entre API (invalida cache) e site.
REVALIDATE_SECRET=

# --- API e worker ---
APP_ORIGINS=https://SEU_DOMINIO
PUBLIC_WEB_URL=https://SEU_DOMINIO
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRIVATE_BUCKET=soscomida-private
S3_PUBLIC_BUCKET=soscomida-public
S3_PUBLIC_BASE_URL=

# Produção exige provedor real e adaptador validado no sandbox (docs/PAYMENTS.md).
PAYMENTS_PROVIDER=asaas
ASAAS_BASE_URL=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ADAPTER_VERIFIED=false

# Produção exige SMTP real (ex.: Amazon SES, Brevo, Resend via SMTP).
EMAIL_PROVIDER=smtp
SMTP_URL=
EMAIL_FROM=SOS Comida <nao-responda@SEU_DOMINIO>

METRICS_TOKEN=

# Sem integracao oficial com a SEFAZ (exige certificado ICP-Brasil): notas ficam
# "nao verificaveis" e passam por revisao humana. docs/FISCAL_VALIDATION.md
FISCAL_VERIFICATION_PROVIDER=none

# Copie para .env. Valores para a infraestrutura de `pnpm dev:infra`.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

DATABASE_URL=postgres://soscomida:soscomida_dev@127.0.0.1:5440/soscomida
REDIS_URL=redis://127.0.0.1:6390

# 32 bytes aleatórios em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

S3_ENDPOINT=http://127.0.0.1:9010
S3_REGION=us-east-1
S3_ACCESS_KEY=soscomida
S3_SECRET_KEY=soscomida_dev
S3_FORCE_PATH_STYLE=true
S3_PRIVATE_BUCKET=soscomida-private
S3_PUBLIC_BUCKET=soscomida-public
S3_PUBLIC_BASE_URL=http://127.0.0.1:9010/soscomida-public

# dev = cobranças NÃO pagáveis (só desenvolvimento). asaas = ver docs/PAYMENTS.md
PAYMENTS_PROVIDER=dev
# ASAAS_BASE_URL=https://sandbox.asaas.com/api
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_ADAPTER_VERIFIED=false
PIX_EXPIRATION_MINUTES=60

# E-mails caem no Mailpit do compose: http://localhost:8025
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=SOS Comida <nao-responda@soscomida.local>

# Expira o cache das páginas públicas do site quando campanhas mudam.
# Mesmo segredo de REVALIDATE_SECRET no apps/web/.env. Opcional (sem ele o cache expira em 5 min).
# WEB_REVALIDATE_URL=http://127.0.0.1:3000/interno/revalidar
# WEB_REVALIDATE_SECRET=

# Consulta de autenticidade das notas. dev = simulada pela tela (só desenvolvimento);
# none = sem integração (produção, até haver certificado ICP-Brasil). Ver docs/FISCAL_VALIDATION.md
FISCAL_VERIFICATION_PROVIDER=dev

# IA da análise de despesas (docs/AI_PIPELINE.md). simulated = regras locais
# fingindo ser a IA (só desenvolvimento; nada sai da máquina, custo zero).
# openai_compatible manda dados para fora e custa dinheiro: exige AI_API_KEY,
# AI_MODEL, preços e orçamento. none = só regras determinísticas.
AI_PROVIDER=simulated
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=
# AI_MONTHLY_BUDGET_CENTS=5000
# AI_INPUT_PRICE_CENTS_PER_MTOK=
# AI_OUTPUT_PRICE_CENTS_PER_MTOK=

# Copie para .env. Valores para a infraestrutura de `pnpm dev:infra`.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

DATABASE_URL=postgres://soscomida:soscomida_dev@127.0.0.1:5440/soscomida
REDIS_URL=redis://127.0.0.1:6390

# 32 bytes aleatórios em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

S3_ENDPOINT=http://127.0.0.1:9010
S3_REGION=us-east-1
S3_ACCESS_KEY=soscomida
S3_SECRET_KEY=soscomida_dev
S3_FORCE_PATH_STYLE=true
S3_PRIVATE_BUCKET=soscomida-private
S3_PUBLIC_BUCKET=soscomida-public
S3_PUBLIC_BASE_URL=http://127.0.0.1:9010/soscomida-public

# dev = cobranças NÃO pagáveis (só desenvolvimento). asaas = ver docs/PAYMENTS.md
PAYMENTS_PROVIDER=dev
# ASAAS_BASE_URL=https://sandbox.asaas.com/api
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_ADAPTER_VERIFIED=false
PIX_EXPIRATION_MINUTES=60

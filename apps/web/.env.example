# URL interna da API (o navegador usa /api, repassado pelo Next).
API_INTERNAL_URL=http://127.0.0.1:4000

# Segredo compartilhado com a API (WEB_REVALIDATE_SECRET) para expirar o cache
# das páginas públicas. Gere com: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
REVALIDATE_SECRET=
